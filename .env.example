OCR_DET_MODEL=./models/det/model_fp32.onnx
OCR_REC_MODEL=./models/rec/model_fp32.onnx
OCR_TABLE_MODEL=./models/table/model_fp32.onnx
OCR_REC_DICT=./models/dictionaries/table_dict.txt
OCR_TABLE_DICT=./models/dictionaries/table_structure_dict.txt

# CPU: CPUExecutionProvider
# GPU: CUDAExecutionProvider,CPUExecutionProvider
# auto prefers CUDA when available and otherwise uses CPU.
OCR_ONNX_PROVIDERS=CPUExecutionProvider
# Per-stage overrides inherit OCR_ONNX_PROVIDERS when omitted. The hybrid
# profile uses CUDA for DB/SVTR and CPU for the autoregressive SLANet decoder:
# OCR_DET_ONNX_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
# OCR_REC_ONNX_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
# OCR_TABLE_ONNX_PROVIDERS=CPUExecutionProvider
OCR_ONNX_THREADS=0
OCR_ONNX_INTER_OP_THREADS=0
OCR_ONNX_GRAPH_OPTIMIZATION=all
OCR_ONNX_EXECUTION_MODE=sequential
OCR_ONNX_ENABLE_MEM_PATTERN=true
OCR_ONNX_ENABLE_CPU_MEM_ARENA=true
OCR_ONNX_LOG_SEVERITY=3

# CUDA provider tuning. A zero memory limit means ORT's default unlimited arena.
OCR_CUDA_DEVICE_ID=0
OCR_CUDA_MEM_LIMIT_MB=0
OCR_CUDA_ARENA_EXTEND_STRATEGY=kNextPowerOfTwo
OCR_CUDA_CUDNN_CONV_ALGO_SEARCH=EXHAUSTIVE
OCR_CUDA_USE_TF32=true

# Exact preprocessing contract of the trained PubTabNet checkpoints.
OCR_DET_LIMIT_SIDE_LEN=736
OCR_DET_LIMIT_TYPE=min
OCR_REC_IMAGE_SHAPE=3,48,320
OCR_REC_BATCH_NUM=32
OCR_TABLE_MAX_LEN=488

# Increase concurrency only after measuring peak memory and p95 latency on the
# deployment host.
OCR_MAX_CONCURRENCY=1
OCR_ACQUIRE_TIMEOUT_SECONDS=30
OCR_WARMUP_RUNS=1

OCR_OUTPUT_DIR=./output/deploy
OCR_OUTPUT_TTL_SECONDS=3600
OCR_MAX_UPLOAD_MB=20
OCR_ENABLE_GRADIO=true
OCR_ENABLE_DOCS=true
OCR_CORS_ORIGINS=
OCR_HOST=0.0.0.0
OCR_PORT=8000
